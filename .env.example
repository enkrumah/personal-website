# Production origin, no trailing slash. Leave unset until a real domain exists.
# Canonical URLs, Open Graph, the sitemap, and JSON-LD use this value.
# NEXT_PUBLIC_SITE_URL=https://example.com

# JSON endpoint that accepts { name, email, message, source }.
# Leave unset until a real inbox exists. The form still validates and asks for email.
# CONTACT_WEBHOOK_URL=https://example.com/contact
