# Production origin, no trailing slash. Leave unset until a real domain exists.
# Development uses http://localhost:3000. Production omits absolute canonical,
# Open Graph, sitemap, and JSON-LD URLs until this is set.
# NEXT_PUBLIC_SITE_URL=https://example.com

# JSON endpoint that accepts { name, email, message, source }.
# Leave unset until a real inbox exists. The form stays visible, submit stays
# disabled, and the page asks people to email. It does not report a sent message.
# CONTACT_WEBHOOK_URL=https://example.com/contact
